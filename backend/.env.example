# Database connection string (MySQL 8+)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/hostel360"

# Server configuration
PORT=5000
NODE_ENV=development

# Frontend application URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# JWT Secrets (generate strong random secrets for production)
ACCESS_TOKEN_SECRET="super-secret-access-token-key-change-in-production-360"
REFRESH_TOKEN_SECRET="super-secret-refresh-token-key-change-in-production-360"

# QR Token TTL in seconds (15 to 30 seconds per ARCHITECTURE.md)
QR_TTL_SECONDS=20

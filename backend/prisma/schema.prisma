generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  WARDEN
  VICE_WARDEN
  CARETAKER
  MESS_ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentState {
  INSIDE
  OUTSIDE
}

enum HostelType {
  BOYS
  GIRLS
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  CLOSED
}

enum DevicePurpose {
  GATE
  MESS
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

enum QrTokenStatus {
  UNUSED
  USED
  EXPIRED
  REVOKED
}

enum AttendanceDirection {
  ENTRY
  EXIT
}

enum ActorType {
  USER
  DEVICE
  SYSTEM
}

enum DayType {
  EVERYDAY
  WEEKDAY
  WEEKEND
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CurfewAlertType {
  OVERNIGHT_NOT_RETURNED
  EXIT_DURING_CURFEW
}

enum CurfewAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum DevicePresenceEventType {
  CONNECTED
  DISCONNECTED
}

enum RiskTier {
  LOW
  HIGH
}

enum WindowStatus {
  UPCOMING
  OPEN
  CLOSED
  PROCESSED
}

enum ApplicationStatus {
  PENDING
  ALLOCATED
  FLAGGED
  ESCALATED
  CANCELLED
}

enum BatchStatus {
  COMPLETED
  CONFIRMED
  CANCELLED
}

enum CascadeStep {
  TARGET_FLOOR
  ADJACENT_FLOOR
  ANY_FLOOR
  REDIRECTED_HOSTEL
  ACCESSIBILITY_PREPASS
}

enum AllocationStatus {
  PROPOSED
  CONFIRMED
  FLAGGED
  REJECTED
  CANCELLED
}

enum SwapStatus {
  PENDING_PEER_ACCEPTANCE
  PEER_ACCEPTED
  ESCALATED_TO_WARDEN
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  name          String         @db.VarChar(120)
  email         String         @unique @db.VarChar(255)
  password_hash String         @db.VarChar(255)
  role          Role
  is_active     Boolean        @default(true)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  student                      Student?
  staff_hostel_assignments     StaffHostelAssignment[]
  staff_mess_assignments       StaffMessAssignment[]
  registered_devices           Device[]                @relation("UserRegisteredDevices")
  refresh_tokens               RefreshToken[]
  updated_curfew_windows       CurfewWindow[]          @relation("UserUpdatedCurfewWindows")
  decided_leave_requests       LeaveRequest[]          @relation("UserDecidedLeaveRequests")
  verified_leave_requests      LeaveRequest[]          @relation("UserVerifiedLeaveRequests")
  resolved_curfew_alerts       CurfewAlert[]           @relation("UserResolvedCurfewAlerts")
  created_registration_windows RegistrationWindow[]    @relation("WindowCreator")
  executed_allocation_batches  AllocationBatch[]       @relation("BatchExecutor")
  confirmed_allocations        RoomAllocation[]        @relation("AllocationConfirmer")
  decided_swaps                RoomSwapRequest[]       @relation("SwapDecider")

  @@map("users")
}

model Student {
  id            String       @id @default(uuid())
  user_id       String       @unique
  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  roll_number   String       @unique @db.VarChar(30)
  gender        Gender       @default(MALE)
  department    String?      @db.VarChar(50)
  year          Int?
  hostel_id     String
  hostel        Hostel       @relation(fields: [hostel_id], references: [id])
  room_id       String?
  room          Room?        @relation(fields: [room_id], references: [id], onDelete: SetNull)
  photo_url     String?      @db.VarChar(512)
  current_state StudentState @default(INSIDE)
  state_since   DateTime     @default(now())
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  hostel_attendance       HostelAttendance[]
  mess_attendance         MessAttendance[]
  leave_requests          LeaveRequest[]
  curfew_alerts           CurfewAlert[]
  device_presence_signals DevicePresenceSignal[]
  hostel_applications     HostelApplication[]
  room_allocations        RoomAllocation[]
  swap_requests_sent      RoomSwapRequest[]      @relation("SwapSenderStudent")
  swap_requests_received  RoomSwapRequest[]      @relation("SwapTargetStudent")

  @@map("students")
}

model Hostel {
  id             String     @id @default(uuid())
  code           String     @unique @db.VarChar(10)
  name           String     @unique @db.VarChar(120)
  type           HostelType @default(BOYS)
  has_blocks     Boolean    @default(false)
  location       String     @db.VarChar(255)
  total_capacity Int
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  rooms                    Room[]
  gates                    Gate[]
  students                 Student[]
  messes                   Mess[]
  hostel_attendance        HostelAttendance[]
  staff_hostel_assignments StaffHostelAssignment[]
  curfew_windows           CurfewWindow[]
  leave_requests           LeaveRequest[]
  curfew_alerts            CurfewAlert[]
  device_presence_signals  DevicePresenceSignal[]
  registration_windows     RegistrationWindow[]
  floor_year_mappings      FloorYearMapping[]
  hostel_applications      HostelApplication[]    @relation("AppliedHostel")
  redirected_applications  HostelApplication[]    @relation("RedirectedApplications")
  allocation_batches       AllocationBatch[]
  room_allocations         RoomAllocation[]

  @@map("hostels")
}

model Room {
  id            String     @id @default(uuid())
  hostel_id     String
  hostel        Hostel     @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  block         String?    @db.VarChar(2)
  floor         Int        @default(0)
  room_number   String     @db.VarChar(10)
  capacity      Int        @default(2)
  is_accessible Boolean    @default(false)
  status        RoomStatus @default(ACTIVE)
  created_at    DateTime   @default(now())

  students           Student[]
  room_allocations   RoomAllocation[]
  swap_requests_from RoomSwapRequest[] @relation("SwapSenderRoom")
  swap_requests_to   RoomSwapRequest[] @relation("SwapTargetRoom")

  @@unique([hostel_id, block, room_number])
  @@map("rooms")
}

model Gate {
  id         String   @id @default(uuid())
  hostel_id  String
  hostel     Hostel   @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(80)
  created_at DateTime @default(now())

  devices           Device[]
  qr_tokens         QrToken[]
  hostel_attendance HostelAttendance[]

  @@map("gates")
}

model Device {
  id                String        @id @default(uuid())
  device_code       String?       @unique @db.VarChar(50)
  device_name       String        @db.VarChar(120)
  purpose           DevicePurpose
  gate_id           String?
  gate              Gate?         @relation(fields: [gate_id], references: [id], onDelete: SetNull)
  mess_id           String?
  mess              Mess?         @relation(fields: [mess_id], references: [id], onDelete: SetNull)
  secret_hash       String        @unique @db.VarChar(255)
  is_active         Boolean       @default(true)
  last_heartbeat_at DateTime?
  registered_by     String
  registrant        User          @relation("UserRegisteredDevices", fields: [registered_by], references: [id])
  created_at        DateTime      @default(now())

  qr_tokens         QrToken[]
  hostel_attendance HostelAttendance[]
  mess_attendance   MessAttendance[]

  @@map("devices")
}

model Mess {
  id            String   @id @default(uuid())
  name          String   @unique @db.VarChar(120)
  hostel_id     String?
  hostel        Hostel?  @relation(fields: [hostel_id], references: [id], onDelete: SetNull)
  created_at    DateTime @default(now())

  meal_windows           MealWindow[]
  devices                Device[]
  qr_tokens              QrToken[]
  mess_attendance        MessAttendance[]
  staff_mess_assignments StaffMessAssignment[]

  @@map("messes")
}

model MealWindow {
  id         String   @id @default(uuid())
  mess_id    String
  mess       Mess     @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  meal_type  MealType
  start_time String   @db.VarChar(8)
  end_time   String   @db.VarChar(8)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  qr_tokens       QrToken[]
  mess_attendance MessAttendance[]

  @@map("meal_windows")
}

model QrToken {
  id             String        @id @default(uuid())
  token_hash     String        @unique @db.VarChar(255)
  device_id      String
  device         Device        @relation(fields: [device_id], references: [id], onDelete: Cascade)
  purpose        DevicePurpose
  gate_id        String?
  gate           Gate?         @relation(fields: [gate_id], references: [id], onDelete: SetNull)
  mess_id        String?
  mess           Mess?         @relation(fields: [mess_id], references: [id], onDelete: SetNull)
  meal_window_id String?
  meal_window    MealWindow?   @relation(fields: [meal_window_id], references: [id], onDelete: SetNull)
  status         QrTokenStatus @default(UNUSED)
  expires_at     DateTime
  created_at     DateTime      @default(now())
  used_at        DateTime?

  hostel_attendance HostelAttendance[]
  mess_attendance   MessAttendance[]

  @@index([expires_at, status])
  @@map("qr_tokens")
}

model HostelAttendance {
  id          String              @id @default(uuid())
  student_id  String
  student     Student             @relation(fields: [student_id], references: [id], onDelete: Cascade)
  hostel_id   String
  hostel      Hostel              @relation(fields: [hostel_id], references: [id])
  gate_id     String
  gate        Gate                @relation(fields: [gate_id], references: [id])
  device_id   String
  device      Device              @relation(fields: [device_id], references: [id])
  direction   AttendanceDirection
  scanned_at  DateTime            @default(now())
  qr_token_id String
  qr_token    QrToken             @relation(fields: [qr_token_id], references: [id])

  curfew_alerts CurfewAlert[]

  @@index([student_id, scanned_at])
  @@index([hostel_id, scanned_at])
  @@map("hostel_attendance")
}

model MessAttendance {
  id             String     @id @default(uuid())
  student_id     String
  student        Student    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  mess_id        String
  mess           Mess       @relation(fields: [mess_id], references: [id])
  meal_window_id String
  meal_window    MealWindow @relation(fields: [meal_window_id], references: [id])
  device_id      String
  device         Device     @relation(fields: [device_id], references: [id])
  meal_type      MealType
  date           DateTime   @db.Date
  scanned_at     DateTime   @default(now())
  qr_token_id    String
  qr_token       QrToken    @relation(fields: [qr_token_id], references: [id])

  @@unique([student_id, meal_window_id, date])
  @@index([student_id])
  @@index([mess_id, date, meal_type])
  @@map("mess_attendance")
}

model RefreshToken {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String    @id @default(uuid())
  actor_id    String?
  actor_type  ActorType
  action      String    @db.VarChar(120)
  target_type String?   @db.VarChar(60)
  target_id   String?
  reason      String?   @db.Text
  meta        Json?
  created_at  DateTime  @default(now())

  @@index([created_at])
  @@map("audit_logs")
}

// --- Staff Assignment Tables ---

model StaffHostelAssignment {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  hostel_id   String
  hostel      Hostel   @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  role        Role
  is_primary  Boolean  @default(false)
  assigned_at DateTime @default(now())

  @@unique([user_id, hostel_id])
  @@index([hostel_id])
  @@map("staff_hostel_assignments")
}

model StaffMessAssignment {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mess_id     String
  mess        Mess     @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  role        Role
  assigned_at DateTime @default(now())

  @@unique([user_id, mess_id])
  @@index([mess_id])
  @@map("staff_mess_assignments")
}

model CurfewWindow {
  id                   String   @id @default(uuid())
  hostel_id            String?
  hostel               Hostel?  @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  day_type             DayType  @default(EVERYDAY)
  start_time           String   @db.VarChar(8)
  end_time             String   @db.VarChar(8)
  grace_period_minutes Int      @default(30)
  max_low_risk_hours   Int      @default(8)
  is_active            Boolean  @default(true)
  updated_by           String?
  updater              User?    @relation("UserUpdatedCurfewWindows", fields: [updated_by], references: [id], onDelete: SetNull)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([hostel_id, is_active])
  @@map("curfew_windows")
}

model LeaveRequest {
  id                    String             @id @default(uuid())
  student_id            String
  student               Student            @relation(fields: [student_id], references: [id], onDelete: Cascade)
  hostel_id             String
  hostel                Hostel             @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  requested_from        DateTime
  requested_to          DateTime
  reason                String             @db.Text
  status                LeaveRequestStatus @default(PENDING)
  risk_tier             RiskTier           @default(LOW)
  caretaker_verified_by String?
  caretaker_verifier    User?              @relation("UserVerifiedLeaveRequests", fields: [caretaker_verified_by], references: [id], onDelete: SetNull)
  caretaker_verified_at DateTime?
  caretaker_note        String?            @db.Text
  decided_by            String?
  decider               User?              @relation("UserDecidedLeaveRequests", fields: [decided_by], references: [id], onDelete: SetNull)
  decided_at            DateTime?
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  curfew_alerts CurfewAlert[]

  @@index([student_id, status])
  @@index([hostel_id, status])
  @@index([requested_from, requested_to])
  @@index([risk_tier])
  @@index([decided_by])
  @@index([caretaker_verified_by])
  @@map("leave_requests")
}

model CurfewAlert {
  id                    String            @id @default(uuid())
  student_id            String
  student               Student           @relation(fields: [student_id], references: [id], onDelete: Cascade)
  hostel_id             String
  hostel                Hostel            @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  alert_type            CurfewAlertType
  triggered_at          DateTime          @default(now())
  related_attendance_id String?
  related_attendance    HostelAttendance? @relation(fields: [related_attendance_id], references: [id], onDelete: SetNull)
  leave_request_id      String?
  leave_request         LeaveRequest?     @relation(fields: [leave_request_id], references: [id], onDelete: SetNull)
  status                CurfewAlertStatus @default(OPEN)
  resolved_by           String?
  resolver              User?             @relation("UserResolvedCurfewAlerts", fields: [resolved_by], references: [id], onDelete: SetNull)
  resolved_at           DateTime?
  resolution_note       String?           @db.Text
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  @@index([hostel_id, status])
  @@index([student_id, status])
  @@index([triggered_at])
  @@map("curfew_alerts")
}

// Advisory-only presence signals from simulated WiFi controller/RADIUS events.
// NEVER used to drive alerts, student state changes, or occupancy counts.
model DevicePresenceSignal {
  id         String                  @id @default(uuid())
  student_id String
  student    Student                 @relation(fields: [student_id], references: [id], onDelete: Cascade)
  event_type DevicePresenceEventType
  hostel_id  String
  hostel     Hostel                  @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  timestamp  DateTime                @default(now())

  @@index([student_id, timestamp])
  @@index([hostel_id, timestamp])
  @@map("device_presence_signals")
}

// -------------------------------------------------------------
// BATCH ROOM ALLOCATION & SWAP MODELS (Phase 14)
// -------------------------------------------------------------

model RegistrationWindow {
  id            String       @id @default(uuid())
  academic_year String       @db.VarChar(20)
  semester      Int          @default(1)
  hostel_id     String?
  hostel        Hostel?      @relation(fields: [hostel_id], references: [id], onDelete: SetNull)
  open_from     DateTime
  open_to       DateTime
  status        WindowStatus @default(UPCOMING)
  created_by    String?
  creator       User?        @relation("WindowCreator", fields: [created_by], references: [id], onDelete: SetNull)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  applications       HostelApplication[]
  allocation_batches AllocationBatch[]

  @@index([status, open_from, open_to])
  @@map("registration_windows")
}

model FloorYearMapping {
  id            String   @id @default(uuid())
  hostel_id     String
  hostel        Hostel   @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  floor         Int
  year_of_study Int
  capacity      Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([hostel_id, floor, year_of_study])
  @@map("floor_year_mapping")
}

model HostelApplication {
  id                      String             @id @default(uuid())
  window_id               String
  window                  RegistrationWindow @relation(fields: [window_id], references: [id], onDelete: Cascade)
  student_id              String
  student                 Student            @relation(fields: [student_id], references: [id], onDelete: Cascade)
  hostel_id               String
  hostel                  Hostel             @relation("AppliedHostel", fields: [hostel_id], references: [id], onDelete: Cascade)
  year_of_study           Int
  is_renewal              Boolean            @default(false)
  accessibility_needs     Boolean            @default(false)
  accessibility_details   String?            @db.Text
  document_urls           Json?
  status                  ApplicationStatus  @default(PENDING)
  flag_reason             String?            @db.Text
  redirect_from_hostel_id String?
  redirect_from_hostel    Hostel?            @relation("RedirectedApplications", fields: [redirect_from_hostel_id], references: [id], onDelete: SetNull)
  redirect_reason         String?            @db.Text
  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt

  room_allocation RoomAllocation?

  @@unique([window_id, student_id])
  @@index([hostel_id, status])
  @@map("hostel_applications")
}

model AllocationBatch {
  id               String             @id @default(uuid())
  window_id        String
  window           RegistrationWindow @relation(fields: [window_id], references: [id], onDelete: Cascade)
  hostel_id        String
  hostel           Hostel             @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  lottery_seed     String             @db.VarChar(64)
  total_applicants Int                @default(0)
  allocated_count  Int                @default(0)
  overflow_count   Int                @default(0)
  redirect_count   Int                @default(0)
  escalated_count  Int                @default(0)
  status           BatchStatus        @default(COMPLETED)
  executed_by      String?
  executor         User?              @relation("BatchExecutor", fields: [executed_by], references: [id], onDelete: SetNull)
  created_at       DateTime           @default(now())

  allocations RoomAllocation[]

  @@index([window_id, hostel_id])
  @@map("allocation_batches")
}

model RoomAllocation {
  id             String            @id @default(uuid())
  batch_id       String
  batch          AllocationBatch   @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  application_id String            @unique
  application    HostelApplication @relation(fields: [application_id], references: [id], onDelete: Cascade)
  student_id     String
  student        Student           @relation(fields: [student_id], references: [id], onDelete: Cascade)
  room_id        String
  room           Room              @relation(fields: [room_id], references: [id], onDelete: Cascade)
  hostel_id      String
  hostel         Hostel            @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  assigned_floor Int
  cascade_step   CascadeStep       @default(TARGET_FLOOR)
  status         AllocationStatus  @default(PROPOSED)
  is_clean       Boolean           @default(true)
  flag_reasons   Json?
  confirmed_by   String?
  confirmer      User?             @relation("AllocationConfirmer", fields: [confirmed_by], references: [id], onDelete: SetNull)
  confirmed_at   DateTime?
  review_notes   String?           @db.Text
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  @@index([batch_id, status])
  @@index([hostel_id, status])
  @@map("room_allocations")
}

model RoomSwapRequest {
  id                String     @id @default(uuid())
  sender_student_id String
  sender_student    Student    @relation("SwapSenderStudent", fields: [sender_student_id], references: [id], onDelete: Cascade)
  sender_room_id    String
  sender_room       Room       @relation("SwapSenderRoom", fields: [sender_room_id], references: [id], onDelete: Cascade)
  target_student_id String
  target_student    Student    @relation("SwapTargetStudent", fields: [target_student_id], references: [id], onDelete: Cascade)
  target_room_id    String
  target_room       Room       @relation("SwapTargetRoom", fields: [target_room_id], references: [id], onDelete: Cascade)
  status            SwapStatus @default(PENDING_PEER_ACCEPTANCE)
  is_cross_tier     Boolean    @default(false)
  peer_accepted_at  DateTime?
  decided_by        String?
  decider           User?      @relation("SwapDecider", fields: [decided_by], references: [id], onDelete: SetNull)
  decided_at        DateTime?
  decision_note     String?    @db.Text
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  @@index([sender_student_id, status])
  @@index([target_student_id, status])
  @@map("room_swap_requests")
}

